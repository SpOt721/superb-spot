# 배포용 시크릿 예시.
#
#  - Streamlit Community Cloud : 앱 → Settings → Secrets 에 아래 내용을 붙여넣기
#                                (파일을 만들 필요 없음)
#  - 로컬에서 .env 대신 쓰려면  : 이 파일을 .streamlit/secrets.toml 로 복사
#
# config.py 가 이 값들을 os.environ 으로 넣어 주므로 코드는 .env 와 동일하게 동작한다.
# .streamlit/secrets.toml 은 .gitignore 에 있으니 절대 커밋되지 않는다.

SUPERB_AI_API_KEY = "sbd_pk_..."
SUPERB_AI_TENANT = "spot"
SUPERB_DEPLOYMENT_ID = "6008abc6-71b6-4c45-9d9c-a89cd14266fe"
SUPERB_PROJECT_ID = "7b267a4e-eea0-4764-9a61-6d74515a4985"
SUPERB_DATASET_ID = "ded47876-a675-492e-a548-c296f80fd151"
SUPERB_CLASS_ID = "9fd96ef0-0b00-4157-8633-fabd20a4e6c3"
SUPERB_ANN_DATA_KEY = "answer"
SUPERB_PREDICT_MAX_WAIT = "90"

# 105MB 가중치는 레포에 없다 — Releases 에서 받아오게 URL 지정 (선택)
